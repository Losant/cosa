{
  "name": "cosa",
  "version": "10.0.0",
  "description": "Cosa Models for MongoDB",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": ">=20",
    "yarn": ">=1.2.1"
  },
  "scripts": {
    "lint": "eslint . --ext .js",
    "lint:fix": "yarn lint --fix",
    "lint:changed": "lint-staged",
    "reinstall": "rm -rf node_modules && yarn install",
    "test": "NODE_ENV='test' COSA_DB_URI='mongodb://localhost:27017/test' mocha",
    "test-debug": "yarn test --debug-brk",
    "doc": "documentation build lib/index.js -f md --github > API.md"
  },
  "author": "Losant <hello@losant.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Losant/cosa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Losant/cosa.git"
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "debug": "^4.4.1",
    "etag": "^1.8.1",
    "joi": "^18.0.1",
    "mongodb": "~6.18.0",
    "object-path": "^0.11.8",
    "omnibelt": "^4.0.0"
  },
  "devDependencies": {
    "@losant/eslint-config-losant": "^2.0.1",
    "husky": "^9.1.5",
    "lint-staged": "^16.1.5",
    "chai": "^6.0.1",
    "chai-as-promised": "^8.0.2",
    "chai-datetime": "^1.8.1",
    "documentation": "^14.0.3",
    "mocha": "^11.7.1"
  },
  "mocha": {
    "require": "chai",
    "reporter": "spec",
    "ui": "bdd",
    "check-leaks": true
  }
}